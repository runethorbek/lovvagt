# Neon Postgres pooled connection string
DATABASE_URL=
# Neon Postgres direct (unpooled) connection string, for migrations
DATABASE_URL_UNPOOLED=
# Vercel Blob store ID for the production store (lovvagt-docs), including the store_ prefix
BLOB_STORE_ID=
# Vercel Blob store ID for the development/preview store (lovvagt-docs-dev)
DEV_BLOB_STORE_ID=
# Vercel OIDC token used to authenticate to Blob. Secret and short-lived:
# set by Vercel at runtime; locally refreshed by `vercel env pull .env.local`
VERCEL_OIDC_TOKEN=
# Gemini API key (use the dev Google project key locally)
GEMINI_API_KEY=
# Bearer secret for protected endpoints such as /api/health (different per environment)
CRON_SECRET=
